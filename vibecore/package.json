{
  "name": "vibecore",
  "version": "1.0.0",
  "description": "VibeCore Backend API for ReadVibe and VibeDesk ecosystem",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js --exec babel-node",
    "server": "nodemon src/server.js --exec babel-node",
    "start": "node build/server.js",
    "build": "babel src -d build",
    "babel-build": "babel src -d build",
    "test": "node tests/runner.js",
    "db:create": "sequelize-cli db:create",
    "db:drop": "sequelize-cli db:drop",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:all": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo",
    "db:seed:undo:all": "sequelize-cli db:seed:undo:all",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed:all",
    "db:reset": "npm run db:drop && npm run db:create && npm run db:migrate && npm run db:seed:all",
    "migration:generate": "sequelize-cli migration:generate",
    "seed:generate": "sequelize-cli seed:generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.32.0",
    "axios": "^1.21.0",
    "bcrypt": "^5.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.1",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.1",
    "sequelize": "^6.32.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.9",
    "@babel/core": "^7.22.9",
    "@babel/node": "^7.22.6",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/preset-env": "^7.22.9",
    "babel-plugin-module-resolver": "^5.0.0",
    "nodemon": "^3.0.1",
    "sequelize-cli": "^6.6.1"
  }
}
